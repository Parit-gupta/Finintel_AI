Project FinIntel_AI_Enterprise_Banking_Platform {
  database_type: 'PostgreSQL'
  Note: 'FinIntel AI - Enterprise Banking Platform ER Model'
}

Table roles {
  role_id bigserial [pk, not null]
  role_name varchar(50) [not null, unique, note: 'Admin / Branch Manager / Loan Officer / Fraud Analyst / Customer Support / Data Analyst']
  description text
  permissions jsonb [note: 'Structured module-level permission set']
  created_at timestamptz [not null, default: `now()`]

  Note: 'System roles for RBAC'
}

Table users {
  user_id bigserial [pk, not null]
  username varchar(50) [not null, unique]
  email varchar(150) [not null, unique]
  password_hash varchar(255) [not null]
  role_id bigint [not null]
  branch_id bigint
  status varchar(20) [not null, default: 'Active']
  last_login timestamptz
  created_at timestamptz [not null, default: `now()`]

  Note: 'Platform login accounts'
}

Table branches {
  branch_id bigserial [pk, not null]
  branch_name varchar(100) [not null]
  branch_code varchar(20) [not null, unique, note: 'e.g. IFSC code']
  address text [not null]
  city varchar(50) [not null]
  state varchar(50)
  country varchar(50) [not null]
  postal_code varchar(20)
  phone_number varchar(20)
  manager_id bigint [note: 'Should reference an employee assigned to this same branch']
  opening_date date
  status varchar(20) [not null, default: 'Active']
  created_at timestamptz [not null, default: `now()`]

  Note: 'Bank branch master'
}

Table employees {
  employee_id bigserial [pk, not null]
  branch_id bigint [not null]
  first_name varchar(50) [not null]
  last_name varchar(50) [not null]
  email varchar(100) [not null, unique]
  phone_number varchar(20) [unique]
  designation varchar(50) [not null, note: 'Manager / Officer / Teller etc.']
  department varchar(50)
  date_of_joining date [not null]
  salary decimal(12,2)
  employment_status varchar(20) [not null, default: 'Active']
  created_at timestamptz [not null, default: `now()`]

  Note: 'Bank employees / staff. Only employees with designation Manager can be referenced by branches.manager_id'
}

Table customers {
  customer_id bigserial [pk, not null]
  branch_id bigint [not null]
  first_name varchar(50) [not null]
  last_name varchar(50) [not null]
  date_of_birth date [not null]
  gender varchar(10)
  email varchar(100) [not null, unique]
  phone_number varchar(20) [not null, unique]
  address text
  city varchar(50)
  state varchar(50)
  country varchar(50)
  postal_code varchar(20)
  national_id varchar(50) [not null, unique, note: 'Government issued ID: SSN / Aadhaar / etc.']
  kyc_status varchar(20) [not null, default: 'Pending', note: 'Verified / Pending / Rejected']
  customer_since date [not null, default: `current_date`]
  status varchar(20) [not null, default: 'Active']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Bank customer master. KYC must be Verified before opening accounts or applying for loans'

  indexes {
    branch_id
  }
}

Table banking_products {
  product_id bigserial [pk, not null]
  product_name varchar(100) [not null]
  product_category varchar(50) [not null, note: 'Deposit / Loan / Card / Investment']
  description text
  interest_rate decimal(5,2)
  min_amount decimal(15,2)
  max_amount decimal(15,2)
  tenure_months int
  eligibility_criteria text
  status varchar(20) [not null, default: 'Active', note: 'Active / Discontinued']
  launched_date date
  created_at timestamptz [not null, default: `now()`]

  Note: 'Bank product catalog. Discontinued products cannot be assigned to new accounts or loans'
}

Table accounts {
  account_id bigserial [pk, not null]
  customer_id bigint [not null]
  branch_id bigint [not null]
  product_id bigint [not null]
  account_number varchar(20) [not null, unique]
  account_type varchar(30) [not null, note: 'Savings / Current / Fixed Deposit']
  currency varchar(10) [not null, default: 'INR']
  balance decimal(15,2) [not null, default: 0.00]
  interest_rate decimal(5,2)
  account_status varchar(20) [not null, default: 'Active', note: 'Active / Dormant / Closed / Frozen']
  opened_date date [not null, default: `current_date`]
  closed_date date
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Customer bank accounts. Closed accounts cannot process new transactions'

  indexes {
    customer_id
    branch_id
  }
}

Table transactions {
  transaction_id bigserial [pk, not null]
  account_id bigint [not null]
  reference_account_id bigint [note: 'Counterparty account for transfers, nullable']
  transaction_type varchar(30) [not null, note: 'Deposit / Withdrawal / Transfer / Payment']
  amount decimal(15,2) [not null, note: 'CHECK (amount > 0)']
  currency varchar(10) [not null, default: 'INR']
  balance_after decimal(15,2)
  channel varchar(30) [note: 'ATM / Online / Mobile App / Branch']
  transaction_status varchar(20) [not null, default: 'Success', note: 'Success / Failed / Pending / Reversed']
  description text
  transaction_date timestamptz [not null, default: `now()`]

  Note: 'Financial transaction ledger. Failed transactions should not alter account balance'

  indexes {
    account_id
    transaction_date
  }
}

Table loan_applications {
  loan_id bigserial [pk, not null]
  customer_id bigint [not null]
  product_id bigint [not null]
  loan_amount decimal(15,2) [not null]
  interest_rate decimal(5,2)
  tenure_months int [not null]
  purpose varchar(100)
  application_date date [not null, default: `current_date`]
  approval_status varchar(20) [not null, default: 'Pending', note: 'Pending / Approved / Rejected / Closed']
  approved_by bigint [note: 'Loan officer or branch manager who approved/rejected']
  approval_date date
  emi_amount decimal(12,2)
  outstanding_amount decimal(15,2)
  created_at timestamptz [not null, default: `now()`]

  Note: 'Customer loan applications. Customer must have Verified KYC to apply'

  indexes {
    customer_id
    loan_id
  }
}

Table credit_history {
  credit_history_id bigserial [pk, not null]
  customer_id bigint [not null]
  credit_score int [not null, note: 'CHECK (credit_score BETWEEN 300 AND 900)']
  credit_bureau varchar(50) [note: 'e.g. Experian']
  total_outstanding_debt decimal(15,2)
  total_credit_limit decimal(15,2)
  active_loans_count int [not null, default: 0]
  missed_payments_count int [not null, default: 0]
  defaults_count int [not null, default: 0]
  report_date date [not null, default: `current_date`]
  created_at timestamptz [not null, default: `now()`]

  Note: 'Customer credit bureau history used for risk assessment and loan decisioning'

  indexes {
    customer_id
    credit_score
  }
}

Table fraud_transactions {
  fraud_id bigserial [pk, not null]
  transaction_id bigint [not null, unique]
  fraud_probability decimal(5,4) [not null, note: 'CHECK (fraud_probability BETWEEN 0 AND 1)']
  fraud_type varchar(50)
  model_used varchar(100)
  detection_time timestamptz [not null, default: `now()`]
  status varchar(20) [not null, default: 'Flagged']

  Note: 'AI fraud detection results. One-to-zero-or-one relationship with transactions'
}

Table support_tickets {
  ticket_id bigserial [pk, not null]
  customer_id bigint [not null]
  assigned_to bigint [note: 'Support agent handling the ticket']
  category varchar(50) [note: 'Complaint / Query / Fraud Report / Feedback']
  subject varchar(150) [not null]
  description text [not null]
  priority varchar(20) [not null, default: 'Medium', note: 'Low / Medium / High / Critical']
  status varchar(20) [not null, default: 'Open', note: 'Open / In Progress / Resolved / Closed']
  created_at timestamptz [not null, default: `now()`]
  resolved_at timestamptz
  resolution_notes text

  Note: 'Customer support tickets. Critical tickets should trigger immediate escalation'

  indexes {
    customer_id
  }
}

Table marketing_campaigns {
  campaign_id bigserial [pk, not null]
  customer_id bigint [not null]
  product_id bigint [not null]
  campaign_name varchar(100) [not null]
  campaign_type varchar(50) [note: 'Email / SMS / Push Notification / Call']
  start_date date [not null]
  end_date date
  channel varchar(30)
  response_status varchar(20) [not null, default: 'No Response', note: 'Interested / Converted / Declined / No Response']
  conversion_date date
  created_at timestamptz [not null, default: `now()`]

  Note: 'Targeted marketing campaigns; each row is one customer-campaign interaction'

  indexes {
    customer_id
  }
}

Table prediction_history {
  prediction_id bigserial [pk, not null]
  customer_id bigint [not null]
  reviewed_by bigint [note: 'Analyst who reviewed the prediction']
  model_name varchar(100) [not null]
  prediction_type varchar(50) [not null, note: 'Churn / Fraud Risk / Credit Risk / Loan Default']
  prediction_result varchar(50) [not null]
  confidence_score decimal(5,4) [note: 'CHECK (confidence_score BETWEEN 0 AND 1)']
  input_features jsonb [note: 'Snapshot of input features used']
  prediction_date timestamptz [not null, default: `now()`]
  review_status varchar(20) [not null, default: 'Pending', note: 'Pending / Confirmed / Dismissed']

  Note: 'AI/ML model prediction audit log'

  indexes {
    customer_id
    prediction_date
  }
}

Table branch_performance {
  performance_id bigserial [pk, not null]
  branch_id bigint [not null]
  report_month date [not null, note: 'First day of the reporting month']
  total_customers int [not null, default: 0]
  new_accounts_opened int [not null, default: 0]
  total_deposits decimal(18,2) [not null, default: 0.00]
  total_withdrawals decimal(18,2) [not null, default: 0.00]
  total_loans_disbursed decimal(18,2) [not null, default: 0.00]
  loans_approved_count int [not null, default: 0]
  revenue_generated decimal(18,2) [not null, default: 0.00]
  customer_satisfaction_score decimal(4,2)
  created_at timestamptz [not null, default: `now()`]

  Note: 'Monthly branch KPI performance snapshot. One record per branch per month'

  indexes {
    branch_id
    report_month
    (branch_id, report_month) [unique]
  }
}

// -------------------------------------------------
// Relationships
// -------------------------------------------------

Ref: users.role_id > roles.role_id
Ref: users.branch_id > branches.branch_id

Ref: employees.branch_id > branches.branch_id
Ref: branches.manager_id > employees.employee_id

Ref: customers.branch_id > branches.branch_id

Ref: accounts.customer_id > customers.customer_id
Ref: accounts.branch_id > branches.branch_id
Ref: accounts.product_id > banking_products.product_id

Ref: transactions.account_id > accounts.account_id
Ref: transactions.reference_account_id > accounts.account_id

Ref: loan_applications.customer_id > customers.customer_id
Ref: loan_applications.product_id > banking_products.product_id
Ref: loan_applications.approved_by > employees.employee_id

Ref: credit_history.customer_id > customers.customer_id

Ref: fraud_transactions.transaction_id - transactions.transaction_id

Ref: support_tickets.customer_id > customers.customer_id
Ref: support_tickets.assigned_to > employees.employee_id

Ref: marketing_campaigns.customer_id > customers.customer_id
Ref: marketing_campaigns.product_id > banking_products.product_id

Ref: prediction_history.customer_id > customers.customer_id
Ref: prediction_history.reviewed_by > employees.employee_id

Ref: branch_performance.branch_id > branches.branch_id
