# Copy this file to .env and fill only values for services you use.
AWS_DEFAULT_REGION=us-east-1
FININTEL_S3_BUCKET=your-private-bucket-name

# Amazon SES / SNS notifications (leave disabled until AWS identities and
# permissions are configured).
FININTEL_EMAIL_NOTIFICATIONS_ENABLED=false
FININTEL_SES_FROM_EMAIL=verified-sender@example.com
FININTEL_SES_CONFIGURATION_SET=
FININTEL_SNS_TOPIC_ARN=

# Optional PostgreSQL connection. DATABASE_URL takes precedence if provided.
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
